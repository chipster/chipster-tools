#!/bin/bash
# Checks that the staged R scripts are formatted with Air (settings in air.toml).
# Enable with: git config core.hooksPath .githooks
#
# Without Air installed the check is skipped, and the Format workflow on GitHub
# checks the files instead. Air checks the files as they are in the working
# tree, so with partly staged changes it also sees the unstaged ones.

set -euo pipefail

if ! command -v air >/dev/null; then
    echo "pre-commit: air not installed, skipping the R format check" >&2
    exit 0
fi

# A read loop rather than mapfile, which macOS's bash 3.2 doesn't have.
files=()
while IFS= read -r -d '' f; do
    files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.R' '*.r')

if [ ${#files[@]} -eq 0 ]; then
    exit 0
fi

if ! air format --check "${files[@]}"; then
    echo "pre-commit: format these with 'air format FILE...' and stage them again" >&2
    exit 1
fi
